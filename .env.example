# ==============================================================================
# Machine-Day Composer Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows PowerShell: Copy-Item .env.example .env)
# 2. In your Supabase Dashboard:
#      - Go to Project Settings -> Configuration -> Database
#      - Under "Connection string", select "URI"
#      - Choose "Session mode" (port 5432) or "Transaction pooler" (port 6543)
#      - Copy the URI and replace [YOUR-PASSWORD] with your actual database password
# 3. Paste the URI below into DATABASE_URL.
#    Note: Either "postgresql://" or "postgresql+psycopg://" prefixes are supported.
# ==============================================================================

# Database Configuration (Supabase PostgreSQL Free Tier)
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Application Settings
PROJECT_NAME=Machine-Day Composer
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# ==============================================================================
# Machine-Day Composer Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to create your local .env file (if not already created):
#      PowerShell: Copy-Item .env.example .env
#      Linux/macOS: cp .env.example .env
#
# 2. Configuration Categories:
#    - [OPTIONAL FOR BASIC STARTUP]: Application settings and JWT secrets have safe
#      development defaults. The server, /health, and /docs endpoints run without a live DB.
#    - [REQUIRED FOR DATABASE FEATURES]: DATABASE_URL is required to run migrations
#      and execute database-backed API endpoints (registration, login, bookings).
#
# 3. Setting up Supabase PostgreSQL Free Tier:
#    - In Supabase Dashboard: Project Settings -> Configuration -> Database
#    - Under "Connection string", select "URI"
#    - Choose "Session mode" (port 5432) or "Transaction pooler" (port 6543)
#    - Copy the URI and replace [YOUR-PASSWORD] with your actual database password
#    - Paste the URI below into DATABASE_URL.
#    - Note: Both "postgresql://" and "postgresql+psycopg://" prefixes are supported.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED FOR DATABASE-BACKED FEATURES & MIGRATIONS
# ------------------------------------------------------------------------------
# Set your real Supabase connection string below:
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# OPTIONAL FOR STARTUP (Safe development defaults applied if omitted)
# ------------------------------------------------------------------------------
PROJECT_NAME=Machine-Day Composer
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# JWT & Authentication Security (Override for production)
JWT_SECRET_KEY=insecure-development-secret-key-please-override-in-env-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Supabase Configuration for NITI Frontend (Vite)
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local frontend/.env file:
#      PowerShell: Copy-Item frontend/.env.example frontend/.env
#      Linux/macOS: cp frontend/.env.example frontend/.env
#
# 2. In your Supabase Project Dashboard:
#    - Navigate to: Project Settings -> API
#    - Copy "Project URL" and set below as VITE_SUPABASE_URL
#    - Copy "anon public" Key and set below as VITE_SUPABASE_PUBLISHABLE_KEY
#
# IMPORTANT:
# - All demo and mock fallback records have been removed from the runtime.
# - The application uses Supabase as its single source of truth for:
#   centres, farmers, operators, machinery, bookings, and chc_overview.
# ==============================================================================

VITE_SUPABASE_URL=https://[YOUR-SUPABASE-PROJECT-ID].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-ANON-PUBLISHABLE-KEY]

# ==============================================================================
# Map & Routing Integration Configuration (Leaflet + OpenStreetMap + OSRM)
# ==============================================================================
# OpenStreetMap Tile Server URL (Free, no API key required)
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# OSRM Driving Route API (Free public demo instance; self-hosted or Mapbox in production)
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# OpenStreetMap Nominatim Reverse Geocoding API (Free with User-Agent header)
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org

